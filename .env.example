APP_NAME="Buy Box Repricer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=buybox
DB_USERNAME=buybox
DB_PASSWORD=buybox

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_PREFIX=buybox:
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Buy Box Repricer -------------------------------------------------------
# Our seller id on the (simulated) marketplace.
MARKET_SELLER_ID=OUR-STORE
# Simulator realism knobs (see config/simulator.php).
SIM_FAULT_429_BPS=0
SIM_FAULT_503_BPS=0

# --- Live updates (Laravel Reverb) -----------------------------------------------
# Server-to-server: where Laravel sends broadcasts (the Reverb process).
REVERB_APP_ID=buybox
REVERB_APP_KEY=buybox-key
REVERB_APP_SECRET=change-me
REVERB_HOST=127.0.0.1
REVERB_PORT=8090
REVERB_SCHEME=http
# Where the Reverb server listens.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090
# Where browsers connect. Empty = same host/port as the page (nginx proxies /app to Reverb).
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=
REVERB_CLIENT_SCHEME=

# --- Public demo -------------------------------------------------------------------
# true: anonymous visitors can operate the dashboard (rate-limited, capped, reset on a schedule).
# false: every page and action requires a logged-in user.
DEMO_MODE=true
